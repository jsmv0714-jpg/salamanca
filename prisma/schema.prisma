generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model areas_of_expertise {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                    @unique @db.VarChar(150)
  slug                    String                    @unique @db.VarChar(150)
  description             String?
  is_active               Boolean                   @default(true)
  created_at              DateTime                  @default(now()) @db.Timestamp(6)
  updated_at              DateTime                  @default(now()) @db.Timestamp(6)
  publication_areas       publication_areas[]
  venture_areas           venture_areas[]
  directory_profile_areas directory_profile_areas[]
}

model associations {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @unique @db.Uuid
  name          String   @db.VarChar(200)
  sector_id     String?  @db.Uuid
  logo_url      String?  @db.VarChar(500)
  website       String?  @db.VarChar(500)
  description   String?
  core_activity String?
  contact_email String?  @db.VarChar(150)
  contact_phone String?  @db.VarChar(50)
  address       String?  @db.VarChar(255)
  city          String?  @db.VarChar(100)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @db.Timestamp(6)
  sectors       sectors? @relation(fields: [sector_id], references: [id], onUpdate: NoAction)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model careers {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @unique @db.VarChar(150)
  slug                String                @unique @db.VarChar(150)
  faculty             String?               @db.VarChar(150)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  publication_careers publication_careers[]
  students            students[]
}

model companies {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String              @unique @db.Uuid
  trade_name      String              @db.VarChar(200)
  legal_name      String?             @db.VarChar(200)
  tax_id          String?             @db.VarChar(50)
  sector_id       String?             @db.Uuid
  logo_url        String?             @db.VarChar(500)
  website         String?             @db.VarChar(500)
  description     String?
  address         String?             @db.VarChar(255)
  city            String?             @db.VarChar(100)
  contact_email   String?             @db.VarChar(150)
  contact_phone   String?             @db.VarChar(50)
  linkedin_url    String?             @db.VarChar(500)
  is_mipyme       Boolean             @default(true)
  alliance_status alliance_status_mvp @default(none)
  created_at      DateTime            @default(now()) @db.Timestamp(6)
  updated_at      DateTime            @default(now()) @db.Timestamp(6)
  sectors         sectors?            @relation(fields: [sector_id], references: [id], onUpdate: NoAction)
  users           users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model entrepreneurs {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @unique @db.Uuid
  first_name   String   @db.VarChar(100)
  last_name    String   @db.VarChar(100)
  project_name String?  @db.VarChar(200)
  description  String?
  phone        String?  @db.VarChar(50)
  website      String?  @db.VarChar(500)
  linkedin_url String?  @db.VarChar(500)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @db.Timestamp(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model publication_areas {
  publication_id     String             @db.Uuid
  area_id            String             @db.Uuid
  areas_of_expertise areas_of_expertise @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publications       publications       @relation(fields: [publication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([publication_id, area_id])
}

model publication_careers {
  publication_id String       @db.Uuid
  career_id      String       @db.Uuid
  careers        careers      @relation(fields: [career_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publications   publications @relation(fields: [publication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([publication_id, career_id])
}

model publication_sectors {
  publication_id String       @db.Uuid
  sector_id      String       @db.Uuid
  publications   publications @relation(fields: [publication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sectors        sectors      @relation(fields: [sector_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([publication_id, sector_id])
}

model publication_types {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         publication_type_code @unique
  name         String                @db.VarChar(100)
  description  String?
  is_active    Boolean               @default(true)
  created_at   DateTime              @default(now()) @db.Timestamp(6)
  publications publications[]
}

model publications {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String                @db.Uuid
  author_type         author_type
  publication_type_id String                @db.Uuid
  title               String                @db.VarChar(200)
  slug                String                @unique @db.VarChar(250)
  description         String
  requirements        String?
  benefits            String?
  location            String?               @db.VarChar(150)
  modality            modality_type?
  deadline            DateTime?             @db.Date
  contact_email       String?               @db.VarChar(150)
  contact_phone       String?               @db.VarChar(50)
  show_contact        Boolean               @default(true)
  status              publication_status    @default(draft)
  views_count         Int                   @default(0)
  published_at        DateTime?             @db.Timestamp(6)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @updatedAt @db.Timestamp(6)
  publication_areas   publication_areas[]
  publication_careers publication_careers[]
  publication_sectors publication_sectors[]
  publication_types   publication_types     @relation(fields: [publication_type_id], references: [id], onUpdate: NoAction)
  users               users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rejection_reason    String?
  applications        applications[]
  publication_media   publication_media[]
  reports             publication_reports[]
  publication_marks   publication_marks[]

  @@index([status, published_at], map: "idx_publications_status_published_at")
  @@index([user_id], map: "idx_publications_user_id")
}

/// Imágenes y videos de una publicación. El archivo vive en el almacenamiento de objetos; aquí solo su clave.
model publication_media {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publication_id String       @db.Uuid
  kind           media_kind
  storage_key    String       @unique @db.VarChar(300)
  thumb_key      String?      @db.VarChar(300)
  mime_type      String       @db.VarChar(100)
  size_bytes     Int
  position       Int          @default(0)
  created_at     DateTime     @default(now()) @db.Timestamp(6)
  publications   publications @relation(fields: [publication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([publication_id, position], map: "idx_publication_media_publication_position")
}

enum media_kind {
  image
  video
}

model sectors {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @unique @db.VarChar(150)
  slug                String                @unique @db.VarChar(150)
  description         String?
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  associations        associations[]
  companies           companies[]
  publication_sectors publication_sectors[]
  ventures            ventures[]
  directory_profiles  directory_profiles[]
}

model students {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String                @unique @db.Uuid
  first_name    String                @db.VarChar(100)
  last_name     String                @db.VarChar(100)
  document_id   String?               @db.VarChar(50)
  career_id     String?               @db.Uuid
  semester      String?               @db.VarChar(20)
  phone         String?               @db.VarChar(50)
  bio           String?
  skills        Json?
  cv_url        String?               @db.VarChar(500)
  portfolio_url String?               @db.VarChar(500)
  linkedin_url  String?               @db.VarChar(500)
  availability  student_availability?
  created_at    DateTime              @default(now()) @db.Timestamp(6)
  updated_at    DateTime              @default(now()) @db.Timestamp(6)
  careers       careers?              @relation(fields: [career_id], references: [id], onUpdate: NoAction)
  users         users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model teachers {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String   @unique @db.Uuid
  first_name          String   @db.VarChar(100)
  last_name           String   @db.VarChar(100)
  title               String?  @db.VarChar(150)
  research_group_name String?  @db.VarChar(150)
  department          String?  @db.VarChar(150)
  phone               String?  @db.VarChar(50)
  bio                 String?
  linkedin_url        String?  @db.VarChar(500)
  created_at          DateTime @default(now()) @db.Timestamp(6)
  updated_at          DateTime @default(now()) @db.Timestamp(6)
  users               users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String                @default("") @db.VarChar(200)
  email                    String                @unique @db.VarChar(150)
  email_verified           Boolean               @default(false)
  image                    String?               @db.VarChar(500)
  /// Sin uso: better-auth guarda el hash de la contraseña en account.password.
  password_hash            String?               @db.VarChar(255)
  role                     user_role
  status                   user_status           @default(pending)
  email_verified_at        DateTime?             @db.Timestamp(6)
  last_login_at            DateTime?             @db.Timestamp(6)
  headline                 String?               @db.VarChar(160)
  bio                      String?               @db.VarChar(2000)
  skills                   String[]              @default([])
  phone                    String?               @db.VarChar(50)
  city                     String?               @db.VarChar(100)
  website                  String?               @db.VarChar(500)
  contact_email            String?               @db.VarChar(150)
  social_links             Json?
  profile_public           Boolean               @default(false)
  notify_news              Boolean               @default(true)
  news                     news[]
  publication_marks        publication_marks[]
  venture_marks            venture_marks[]
  venture_reports_made     venture_reports[]     @relation("VentureReportReporter")
  venture_reports_reviewed venture_reports[]     @relation("VentureReportReviewer")
  created_at               DateTime              @default(now()) @db.Timestamp(6)
  updated_at               DateTime              @default(now()) @db.Timestamp(6)
  associations             associations?
  companies                companies?
  entrepreneurs            entrepreneurs?
  publications             publications[]
  students                 students?
  teachers                 teachers?
  sessions                 session[]
  accounts                 account[]
  ventures                 ventures[]
  directory_profiles       directory_profiles?
  applications             applications[]
  role_changes_received    role_changes[]        @relation("RoleChangeTarget")
  role_changes_made        role_changes[]        @relation("RoleChangeActor")
  notifications            notifications[]
  reports_made             publication_reports[] @relation("ReportReporter")
  reports_reviewed         publication_reports[] @relation("ReportReviewer")

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
}

model session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  users                 users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

enum alliance_status_mvp {
  none
  intention
  active
}

enum author_type {
  company
  association
  entrepreneur
}

enum modality_type {
  presential
  remote
  hybrid
}

enum publication_status {
  draft
  published
  closed
  rejected
  in_review
}

enum publication_type_code {
  internship
  b2b_offer
  b2b_request
}

enum student_availability {
  full_time
  part_time
  flexible
}

enum user_role {
  company
  student
  teacher
  association
  entrepreneur
  admin
}

enum user_status {
  pending
  active
  suspended
}

/// Historial de promociones y retiros del rol de administrador.
model role_changes {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  changed_by_id String?   @db.Uuid
  from_role     user_role
  to_role       user_role
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  users         users     @relation("RoleChangeTarget", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changed_by    users?    @relation("RoleChangeActor", fields: [changed_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id, created_at], map: "idx_role_changes_user_created")
  @@index([created_at], map: "idx_role_changes_created")
}

// ─── Fase 2: ventures (spin-offs y startups) y directorio del ecosistema Winner ───

model ventures {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String            @db.Uuid
  type              venture_type
  name              String            @db.VarChar(150)
  slug              String            @unique @db.VarChar(180)
  tagline           String?           @db.VarChar(200)
  description       String
  sector_id         String?           @db.Uuid
  business_model    business_model    @default(both)
  /// Nivel de madurez tecnológica (TRL), de 1 a 9.
  trl_level         Int               @default(1)
  /// Etapa del servicio Winner de donde sale (1 Entendimiento ... 6 Seguimiento).
  service_stage     Int?
  /// Solo spin-offs: grupo de investigación y consultor senior responsable.
  research_group    String?           @db.VarChar(150)
  senior_consultant String?           @db.VarChar(150)
  city              String?           @db.VarChar(100)
  logo_url          String?           @db.VarChar(500)
  website           String?           @db.VarChar(500)
  linkedin_url      String?           @db.VarChar(500)
  contact_email     String?           @db.VarChar(150)
  status            venture_status    @default(draft)
  rejection_reason  String?
  published_at      DateTime?         @db.Timestamp(6)
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sectors           sectors?          @relation(fields: [sector_id], references: [id], onUpdate: NoAction)
  venture_areas     venture_areas[]
  venture_marks     venture_marks[]
  venture_reports   venture_reports[]

  @@index([status], map: "idx_ventures_status")
  @@index([type], map: "idx_ventures_type")
  @@index([user_id], map: "idx_ventures_user")
}

model venture_areas {
  venture_id         String             @db.Uuid
  area_id            String             @db.Uuid
  ventures           ventures           @relation(fields: [venture_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  areas_of_expertise areas_of_expertise @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([venture_id, area_id])
}

/// Perfil público de un miembro del ecosistema. Solo aparece en el directorio si is_visible
/// es verdadero y la cuenta está activa.
model directory_profiles {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String                    @unique @db.Uuid
  display_name            String?                   @db.VarChar(200)
  headline                String?                   @db.VarChar(200)
  /// "Core clave" del miembro: en qué es especialista y qué asesoría ofrece.
  core_expertise          String?
  business_model          business_model?
  sector_id               String?                   @db.Uuid
  city                    String?                   @db.VarChar(100)
  website                 String?                   @db.VarChar(500)
  linkedin_url            String?                   @db.VarChar(500)
  logo_url                String?                   @db.VarChar(500)
  contact_email           String?                   @db.VarChar(150)
  is_visible              Boolean                   @default(false)
  created_at              DateTime                  @default(now()) @db.Timestamp(6)
  updated_at              DateTime                  @default(now()) @updatedAt @db.Timestamp(6)
  users                   users                     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sectors                 sectors?                  @relation(fields: [sector_id], references: [id], onUpdate: NoAction)
  directory_profile_areas directory_profile_areas[]

  @@index([is_visible], map: "idx_directory_profiles_visible")
}

model directory_profile_areas {
  profile_id         String             @db.Uuid
  area_id            String             @db.Uuid
  directory_profiles directory_profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  areas_of_expertise areas_of_expertise @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([profile_id, area_id])
}

enum venture_type {
  spin_off
  startup
}

enum venture_status {
  draft
  in_review
  published
  rejected
}

enum business_model {
  b2b
  b2c
  both
}

// ─── Fase 3: postulaciones a publicaciones ───

model applications {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publication_id    String             @db.Uuid
  applicant_id      String             @db.Uuid
  message           String
  /// Enlaces que comparte quien se postula (hoja de vida, portafolio, LinkedIn).
  cv_url            String?            @db.VarChar(500)
  portfolio_url     String?            @db.VarChar(500)
  linkedin_url      String?            @db.VarChar(500)
  phone             String?            @db.VarChar(50)
  /// Autorización para compartir sus datos con quien publicó la oferta.
  data_consent      Boolean            @default(false)
  consent_at        DateTime?          @db.Timestamp(6)
  status            application_status @default(sent)
  /// Cuándo volvió a postularse tras retirarse. Solo se permite una vez: si está fijado, no puede volver a hacerlo.
  reapplied_at      DateTime?          @db.Timestamp(6)
  created_at        DateTime           @default(now()) @db.Timestamp(6)
  updated_at        DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  publications      publications       @relation(fields: [publication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users              @relation(fields: [applicant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  application_files application_files?

  @@unique([publication_id, applicant_id], map: "uq_applications_publication_applicant")
  @@index([applicant_id], map: "idx_applications_applicant")
  @@index([status], map: "idx_applications_status")
}

enum application_status {
  sent
  viewed
  shortlisted
  accepted
  rejected
  withdrawn
}

/// Contadores de intentos de better-auth (límite por IP). Están en la base para compartirlos entre instancias y reinicios.
model rateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique @db.VarChar(255)
  count       Int
  /// Milisegundos desde la época (Date.now()). Float evita el manejo de BigInt en el adaptador.
  lastRequest Float

  @@map("rate_limit")
}

/// Hoja de vida adjunta a una postulación. Se guarda aparte para no cargar el archivo al listar postulaciones.
model application_files {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String       @unique @db.Uuid
  filename       String       @db.VarChar(255)
  mime_type      String       @db.VarChar(100)
  size_bytes     Int
  data           Bytes
  created_at     DateTime     @default(now()) @db.Timestamp(6)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Avisos internos para cada persona (postulaciones, decisiones, reportes).
model notifications {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String            @db.Uuid
  type       notification_type
  title      String            @db.VarChar(200)
  body       String?           @db.VarChar(1000)
  href       String?           @db.VarChar(300)
  read_at    DateTime?         @db.Timestamp(6)
  created_at DateTime          @default(now()) @db.Timestamp(6)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, read_at], map: "idx_notifications_user_read")
  @@index([user_id, created_at], map: "idx_notifications_user_created")
}

enum notification_type {
  application_received
  application_accepted
  application_rejected
  publication_approved
  publication_rejected
  report_created
  report_resolved
}

/// Reportes de abuso sobre una publicación. Los revisa un administrador.
model publication_reports {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publication_id String        @db.Uuid
  reporter_id    String?       @db.Uuid
  reason         report_reason
  details        String?       @db.VarChar(1000)
  status         report_status @default(open)
  admin_note     String?       @db.VarChar(500)
  reviewed_by_id String?       @db.Uuid
  reviewed_at    DateTime?     @db.Timestamp(6)
  created_at     DateTime      @default(now()) @db.Timestamp(6)
  publications   publications  @relation(fields: [publication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?        @relation("ReportReporter", fields: [reporter_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reviewed_by    users?        @relation("ReportReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([publication_id, reporter_id], map: "uq_publication_reports_publication_reporter")
  @@index([status, created_at], map: "idx_publication_reports_status_created")
}

enum report_reason {
  spam
  scam
  inappropriate
  other
}

enum report_status {
  open
  resolved
  dismissed
}

/// Noticias, comunicados y eventos de la institucion. Los publican solo administradores.
model news {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id         String      @db.Uuid
  type              news_type
  title             String      @db.VarChar(200)
  slug              String      @unique @db.VarChar(250)
  summary           String      @db.VarChar(400)
  body              String
  cover_key         String?     @db.VarChar(500)
  status            news_status @default(draft)
  published_at      DateTime?   @db.Timestamp(6)
  event_starts_at   DateTime?   @db.Timestamp(6)
  event_location    String?     @db.VarChar(200)
  event_url         String?     @db.VarChar(500)
  emails_sent_at    DateTime?   @db.Timestamp(6)
  emails_sent_count Int         @default(0)
  created_at        DateTime    @default(now()) @db.Timestamp(6)
  updated_at        DateTime    @default(now()) @updatedAt @db.Timestamp(6)
  users             users       @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, published_at], map: "idx_news_status_published")
  @@index([type, event_starts_at], map: "idx_news_type_event")
}

enum news_type {
  news
  event
  announcement
}

enum news_status {
  draft
  published
}

/// Marcas de una persona sobre una publicacion: guardada (me gusta) u oculta.
model publication_marks {
  user_id        String       @db.Uuid
  publication_id String       @db.Uuid
  saved          Boolean      @default(false)
  hidden         Boolean      @default(false)
  created_at     DateTime     @default(now()) @db.Timestamp(6)
  updated_at     DateTime     @default(now()) @updatedAt @db.Timestamp(6)
  users          users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publications   publications @relation(fields: [publication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, publication_id])
  @@index([user_id, saved], map: "idx_publication_marks_saved")
}

/// Marcas de una persona sobre una venture: guardada (me gusta) u oculta.
model venture_marks {
  user_id    String   @db.Uuid
  venture_id String   @db.Uuid
  saved      Boolean  @default(false)
  hidden     Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ventures   ventures @relation(fields: [venture_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, venture_id])
  @@index([user_id, saved], map: "idx_venture_marks_saved")
}

/// Denuncias sobre una venture. Las revisa un administrador, igual que las de publicaciones.
model venture_reports {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venture_id     String        @db.Uuid
  reporter_id    String?       @db.Uuid
  reason         report_reason
  details        String        @db.VarChar(1000)
  status         report_status @default(open)
  admin_note     String?       @db.VarChar(500)
  reviewed_by_id String?       @db.Uuid
  reviewed_at    DateTime?     @db.Timestamp(6)
  created_at     DateTime      @default(now()) @db.Timestamp(6)
  ventures       ventures      @relation(fields: [venture_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?        @relation("VentureReportReporter", fields: [reporter_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reviewed_by    users?        @relation("VentureReportReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([venture_id, reporter_id], map: "uq_venture_reports_venture_reporter")
  @@index([status, created_at], map: "idx_venture_reports_status_created")
}
