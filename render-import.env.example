# Plantilla para Render -> Environment -> Import from .env
# Copia este archivo a render-import.env, rellena los valores entre <...>
# y pega el contenido en Render. NUNCA subas render-import.env a GitHub.
# Los secretos de GitHub Actions (BACKUP_*) NO van aqui: van en el repo -> Settings -> Secrets.

# DATABASE_URL ya esta configurada en Render: no la incluyas aqui para no sobrescribirla.

# Si Render ya genero BETTER_AUTH_SECRET, conserva ese valor o elimina la linea.
BETTER_AUTH_SECRET=<SECRETO_LARGO_Y_ALEATORIO>
BETTER_AUTH_URL=https://unisalamanca-marketplace.onrender.com
NEXT_PUBLIC_APP_URL=https://unisalamanca-marketplace.onrender.com

# Correo (Resend). Sin clave, los correos solo se imprimen en consola.
RESEND_API_KEY=<RELLENA_SI_YA_VERIFICASTE_EL_DOMINIO>
EMAIL_FROM="Unisalamanca Marketplace <no-reply@TU_DOMINIO_VERIFICADO>"
CONTACT_EMAIL=bienestar@unisalamanca.edu.co

# Cloudflare R2 - bucket de medios (CORS: PUT + Content-Type).
S3_BUCKET=unisalamanca-media
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=<ACCESS_KEY_ID_NUEVO>
S3_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY_NUEVO>
MEDIA_PUBLIC_URL=https://pub-<ID>.r2.dev
