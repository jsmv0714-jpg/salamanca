# Copia este archivo a .env y completa los valores. NUNCA subas el .env a git.

# Conexión a PostgreSQL
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/unisalamanca"

# Clave secreta de better-auth (genera una con: openssl rand -base64 32)
BETTER_AUTH_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# URL pública de la app (en producción, tu dominio)
BETTER_AUTH_URL="http://localhost:3000"
