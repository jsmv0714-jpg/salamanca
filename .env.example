# Copia este archivo a .env y completa los valores. NUNCA subas el .env a git.

# Conexión a PostgreSQL
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/unisalamanca"

# Clave secreta de better-auth (genera una con: openssl rand -base64 32)
BETTER_AUTH_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# URL pública de la app (en producción, tu dominio)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Correo (opcional). Sin RESEND_API_KEY los correos se imprimen en la consola.
RESEND_API_KEY=""
EMAIL_FROM="Unisalamanca Marketplace <no-reply@unisalamanca.edu.co>"

# Correo de contacto que se muestra en la página /contacto
CONTACT_EMAIL=""

# Almacenamiento de imágenes y videos (S3 compatible: Cloudflare R2, AWS S3...).
# Sin S3_BUCKET, en desarrollo los archivos se guardan en .uploads/ y en producción la subida falla.
# Con S3_BUCKET el navegador sube directo con URL firmada: configura CORS en el bucket
# (PUT y cabecera Content-Type desde el dominio de la app).
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL pública del bucket (dominio propio o r2.dev), sin barra final.
# Obligatoria cuando S3_BUCKET está configurado.
MEDIA_PUBLIC_URL=""
